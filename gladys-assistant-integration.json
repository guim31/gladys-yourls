  "scene_actions": [
    {
      "key": "shorten_url",
      "label": {
        "en": "Shorten an address",
        "fr": "Raccourcir une adresse",
        "de": "Adresse kürzen",
        "es": "Acortar una dirección"
      },
      "description": {
        "en": "Creates a short link in YOURLS and gives it to the next actions. An address already shortened gives its link.",
        "fr": "Crée un lien court dans YOURLS et le donne aux actions suivantes. Une adresse déjà raccourcie donne son lien.",
        "de": "Erstellt einen Kurzlink in YOURLS und gibt ihn an die nächsten Aktionen weiter. Eine schon gekürzte Adresse liefert ihren Link.",
        "es": "Crea un enlace corto en YOURLS y lo pasa a las siguientes acciones. Una dirección ya acortada devuelve su enlace."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "url",
          "type": "string",
          "label": {
            "en": "Address to shorten",
            "fr": "Adresse à raccourcir",
            "de": "Zu kürzende Adresse",
            "es": "Dirección que acortar"
          },
          "required": true
        },
        {
          "key": "keyword",
          "type": "string",
          "label": {
            "en": "Keyword (optional)",
            "fr": "Mot-clé (facultatif)",
            "de": "Schlüsselwort (optional)",
            "es": "Palabra clave (opcional)"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title (optional)",
            "fr": "Titre (facultatif)",
            "de": "Titel (optional)",
            "es": "Título (opcional)"
          }
        }
      ],
      "outputs": [
        {
          "key": "keyword",
          "type": "string",
          "label": {
            "en": "Keyword",
            "fr": "Mot-clé",
            "de": "Schlüsselwort",
            "es": "Palabra clave"
          }
        },
        {
          "key": "short_url",
          "type": "string",
          "label": {
            "en": "Short address",
            "fr": "Adresse courte",
            "de": "Kurzadresse",
            "es": "Dirección corta"
          }
        },
        {
          "key": "long_url",
          "type": "string",
          "label": {
            "en": "Target address",
            "fr": "Adresse cible",
            "de": "Zieladresse",
            "es": "Dirección de destino"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "clicks",
          "type": "number",
          "label": {
            "en": "Clicks",
            "fr": "Clics",
            "de": "Klicks",
            "es": "Clics"
          }
        },
        {
          "key": "created",
          "type": "boolean",
          "label": {
            "en": "New link",
            "fr": "Nouveau lien",
            "de": "Neuer Link",
            "es": "Enlace nuevo"
          }
        }
      ]
    },
    {
      "key": "get_link_clicks",
      "label": {
        "en": "Read a short link",
        "fr": "Lire un lien court",
        "de": "Kurzlink lesen",
        "es": "Leer un enlace corto"
      },
      "description": {
        "en": "Reads the clicks of a short link by its keyword, for the next actions.",
        "fr": "Lit les clics d'un lien court d'après son mot-clé, pour les actions suivantes.",
        "de": "Liest die Klicks eines Kurzlinks anhand seines Schlüsselworts, für die nächsten Aktionen.",
