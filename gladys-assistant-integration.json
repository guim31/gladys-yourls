{
  "manifest_version": 1,
  "type": "device",
  "name": "YOURLS",
  "description": {
    "en": "Clicks of your YOURLS short links in Gladys: milestones in scenes, and shorten links from a scene.",
    "fr": "Les clics de vos liens courts YOURLS dans Gladys : paliers en scène, et liens raccourcis par scène.",
    "de": "Klicks deiner YOURLS-Kurzlinks in Gladys: Meilensteine in Szenen, Links per Szene kürzen.",
    "es": "Clics de sus enlaces cortos de YOURLS en Gladys: hitos en escenas, y enlaces acortados por escena."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-yourls:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-yourls/main/cover.png",
  "categories": ["network", "servers"],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your YOURLS",
        "fr": "Votre YOURLS",
        "de": "Dein YOURLS",
        "es": "Su YOURLS"
      },
      "description": {
        "en": "The address of your YOURLS (the one of the short links) and its signature token, on the Tools page of the YOURLS admin. Then add the device from the Discover tab.",
        "fr": "L'adresse de votre YOURLS (celle des liens courts) et son jeton de signature, sur la page Outils de l'admin de YOURLS. Ajoutez ensuite l'appareil depuis l'onglet Découverte.",
        "de": "Die Adresse deines YOURLS (die der Kurzlinks) und sein Signatur-Token, auf der Seite Werkzeuge der YOURLS-Verwaltung. Lege dann das Gerät im Tab „Entdecken“ an.",
        "es": "La dirección de su YOURLS (la de los enlaces cortos) y su token de firma, en la página Herramientas de la administración de YOURLS. Después añada el dispositivo desde la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-yourls/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://yourls.org/docs/guide/advanced/passwordless-api",
          "label": {
            "en": "YOURLS signature token",
            "fr": "Jeton de signature YOURLS",
            "de": "YOURLS-Signatur-Token",
            "es": "Token de firma de YOURLS"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "YOURLS address",
        "fr": "Adresse de YOURLS",
        "de": "YOURLS-Adresse",
        "es": "Dirección de YOURLS"
      },
      "description": {
        "en": "The address of your YOURLS, the one the short links use (with its sub-directory, if any).",
        "fr": "L'adresse de votre YOURLS, celle qu'utilisent les liens courts (avec son sous-dossier, s'il y en a un).",
        "de": "Die Adresse deines YOURLS, die deine Kurzlinks nutzen (mit Unterverzeichnis, falls vorhanden).",
        "es": "La dirección de su YOURLS, la que usan los enlaces cortos (con su subdirectorio, si lo hay)."
      },
      "placeholder": {
        "en": "e.g. https://sho.rt",
        "fr": "ex. https://sho.rt",
        "de": "z. B. https://sho.rt",
        "es": "p. ej. https://sho.rt"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "signature",
      "type": "secret",
      "label": {
        "en": "Signature token",
        "fr": "Jeton de signature",
        "de": "Signatur-Token",
        "es": "Token de firma"
      },
      "description": {
        "en": "Shown on the Tools page of the YOURLS admin. Leave empty to use a username and password instead.",
        "fr": "Affiché sur la page Outils de l'admin de YOURLS. Laissez vide pour utiliser plutôt un nom d'utilisateur et un mot de passe.",
        "de": "Steht auf der Seite Werkzeuge der YOURLS-Verwaltung. Lass es leer, um stattdessen Benutzername und Passwort zu nutzen.",
        "es": "Aparece en la página Herramientas de la administración de YOURLS. Déjelo vacío para usar en su lugar un usuario y una contraseña."
      },
      "required": false
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username (without token)",
        "fr": "Nom d'utilisateur (sans jeton)",
        "de": "Benutzername (ohne Token)",
        "es": "Usuario (sin token)"
      },
      "description": {
        "en": "Only without a signature token: a user of the YOURLS admin.",
        "fr": "Seulement sans jeton de signature : un utilisateur de l'admin de YOURLS.",
        "de": "Nur ohne Signatur-Token: ein Benutzer der YOURLS-Verwaltung.",
        "es": "Solo sin token de firma: un usuario de la administración de YOURLS."
      },
      "required": false,
      "default": ""
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password (without token)",
        "fr": "Mot de passe (sans jeton)",
        "de": "Passwort (ohne Token)",
        "es": "Contraseña (sin token)"
      },
      "required": false
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "keywords",
      "type": "string",
      "label": {
        "en": "Links to follow",
        "fr": "Liens à suivre",
        "de": "Zu verfolgende Links",
        "es": "Enlaces a seguir"
      },
      "description": {
        "en": "Keywords of the short links whose clicks become a feature and fire \"Click milestone\", separated by commas (10 at most).",
        "fr": "Mots-clés des liens courts dont les clics deviennent une fonctionnalité et déclenchent « Palier de clics », séparés par des virgules (10 au plus).",
        "de": "Schlüsselwörter der Kurzlinks, deren Klicks eine Funktion werden und „Klick-Meilenstein“ auslösen, durch Kommas getrennt (höchstens 10).",
        "es": "Palabras clave de los enlaces cortos cuyos clics se convierten en una función y activan «Hito de clics», separadas por comas (10 como máximo)."
      },
      "placeholder": {
        "en": "e.g. news, menu",
        "fr": "ex. news, menu",
        "de": "z. B. news, menu",
        "es": "p. ej. news, menu"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often YOURLS is read: one API request, and one per followed link.",
        "fr": "À quelle fréquence YOURLS est lu : une requête d'API, et une par lien suivi.",
        "de": "Wie oft YOURLS gelesen wird: eine API-Anfrage, und eine pro verfolgtem Link.",
        "es": "Con qué frecuencia se lee YOURLS: una petición de API, y una por enlace seguido."
      },
      "required": false,
      "default": "300",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "900",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names (set when the device is added) and of the scene action errors.",
        "fr": "Langue des noms des fonctionnalités (fixés à l'ajout de l'appareil) et des erreurs des actions de scène.",
        "de": "Sprache der Funktionsnamen (beim Anlegen des Geräts festgelegt) und der Fehler der Szenen-Aktionen.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir el dispositivo) y de los errores de las acciones de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 60
